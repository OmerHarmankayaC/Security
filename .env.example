# Bu dosyayi .env olarak kopyalayip degerleri kendi ortaminiza gore doldurun.
# .env asla commit edilmez (bkz. .gitignore) ve sunucuda 0600 izinle durur.
#
# SIR ICEREN SATIRLAR asagida acikca isaretlidir. Dagitimda bunlari
# uygulamayi kuran kisi doldurur; kaynak kodda, bu dosyada veya herhangi
# bir betikte gercek deger BULUNMAZ (SDD 3.4.5: ortama bagli degerler
# ortam degiskeni olarak saglanir, kaynak kodda yer almaz).

# --- Veritabani ------------------------------------------------------------
# [SIR] Bu satira YALNIZ PAROLA DEGIL, TAM BAGLANTI URL'I yazilir. Asagidaki
# sablonda SADECE <PAROLA> yerini degistirin, gerisini oldugu gibi birakin:
#
#     postgresql+psycopg://vardiya:<PAROLA>@localhost:5432/vardiya
#
# Yalnizca parola yazilirsa uygulama URL'i ayristiramaz; bu hata dagitim
# sirasinda bir kez yasandi.
#
# Parola @ : / ? # [ ] gibi karakterler iceriyorsa URL kodlamasi gerekir
# (ornegin @ -> %40); en kolayi bu karakterleri icermeyen bir parola secmek.
# Ayrica systemd EnvironmentFile bu dosyayi okur: deger tirnaksiz yazilir ve
# icinde # gecerse satirin geri kalani yorum sayilir.
VERITABANI_URL=postgresql+psycopg://vardiya:<PAROLA>@localhost:5432/vardiya

# Test takiminin veritabani (Urun Backlog'u B-20). YALNIZCA GELISTIRME
# MAKINESINDE bulunur; sunucudaki /opt/vardiya/.env bu satiri TASIMAZ, orada
# test kosturulmaz. Uygulama bu ayari hic okumaz - yalnizca
# backend/conftest.py okur ve motoru bu adrese baglar.
#
# Testler gelistirme veritabaninda kosturulmaz: cozum iscisi arka planda
# calisirken test kuyrugundan is kapiyor, test temizligi kullanici
# hesaplarini goturuyor ve kabul olcumu ile testler birbirinin verisini
# boziyordu. Adres bir test veritabanini gostermezse takim CALISMAZ;
# veritabani adi 'test' gecmelidir.
TEST_VERITABANI_URL=postgresql+psycopg://vardiya:<PAROLA>@localhost:5432/vardiya_test

# NOT - API portu burada TANIMLANMAZ. Uvicorn'u systemd baslattigi icin port
# tek yerde, deploy/vardiya-api.service icindeki --port bayragindadir
# (bu makinede 8002; 8000 vera-rag'e, 8001 energy-api'ye ait). Buraya bir
# API_PORT satiri koymak, uygulamanin okumadigi ama otoriter gorunen ikinci
# bir tanim yaratirdi. Port degisirse unit dosyasi ve Caddy blogu birlikte
# guncellenir.

# --- Cozucu ----------------------------------------------------------------
# Cozucuye verilen ust sure siniri (saniye). Kabul kriteri altmis saniyedir
# (Proje Tanim Dokumani bolum 5; SRS NFR-1).
COZUCU_ZAMAN_LIMITI_SANIYE=60

# CP-SAT arama iscisi sayisi. SDD 3.4.3: mevcut cekirdek sayisinin BIR
# EKSIGI olmalidir - kalan cekirdek uygulama sunucusu ve veritabani icin
# ayrilir, aksi halde cozum surerken API yanit veremez hale gelir.
# Dort cekirdekli referans donanimda bu sayi 3'tur.
COZUCU_ARAMA_ISCISI_SAYISI=3

# --- Kimlik dogrulama ------------------------------------------------------
# Bu bolumde SIR YOKTUR ve olmayacaktir. Parolalar veritabaninda Argon2id
# ozeti olarak durur, oturum belirteci her giriste rastgele uretilir; ikisi
# de bir ortam degiskenine dayanmaz. Dolayisiyla "sunucu sirri sizarsa her
# sey acilir" diye bir nokta da yok.
#
# ONEMLI - ESKI ANAHTAR KALDIRILDI. Bu dosyanin onceki surumunde bir
# CALISAN_PANELI_BAGLANTI_ANAHTARI satiri vardi (kisiye ozel baglanti
# yontemi). Kimlik dogrulama geldigi icin o yol tumuyle kalkti. Sunucudaki
# .env dosyasinda O SATIR KALIRSA UYGULAMA ACILMAZ: uygulama acilista
# kaldirilmis anahtarlari ACIKCA arar ve bulursa hata verip cikar
# (app/config.py, _kaldirilmis_anahtarlari_dogrula). Sessizce yok saymak,
# kaldirilmis bir sirrin hala ise yaradigi izlenimini birakirdi.
# Dagitimda satir silinmelidir (bkz. deploy/DAGITIM.md).

# Hareketsizlik suresi (dakika) ve mutlak son kullanma (saat). Ikisi AYRI
# uygulanir: surekli istek gonderen bir oturum hareketsizlige takilmaz ama
# mutlak siniri gecince yine kapanir.
OTURUM_HAREKETSIZLIK_DAKIKA=30
OTURUM_AZAMI_SAAT=12

# Ardisik basarisiz giriste gecici kilit (SRS FR-10.8): kac denemeden sonra,
# kac dakika.
GIRIS_KILIT_ESIGI=5
GIRIS_KILIT_DAKIKA=15

# Oturum cerezinin Secure niteligi. SUNUCUDA true KALMALIDIR (site HTTPS
# uzerinden yayinda). Yalnizca yerel gelistirmede false yapilir: tarayici
# Secure bir cerezi duz http://localhost adresine GERI GONDERMEZ ve giris
# hicbir hata gostermeden basarisiz olur.
OTURUM_CEREZI_SECURE=true

# --- Yikici islem izni -----------------------------------------------------
# Veritabanini bosaltan betikler (scripts/kabul_olcumu.py,
# scripts/demo_veri_uret.py --reset) ve senaryo kuran test fiksturleri, bu
# izin acikca verilmedikce CALISMAZ (app/veri_temizligi.py).
#
# BU SATIR SUNUCUDA BULUNMAMALIDIR. Varsayilani false'tur ve kilit tam da
# ayarin YOKLUGUNDA devrededir; boylece ayari tasimayan her ortam korunur.
# Gelistirme makinesinde backend/.env icine yazilir:
#
#     VERI_TEMIZLIGINE_IZIN=true
#
# Sunucuda gercekten gerekiyorsa (ornegin kabul olcumu, GERCEK KULLANIM
# BASLAMADAN once) tek seferlik komutun onune yazilir:
#
#     VERI_TEMIZLIGINE_IZIN=true .venv/bin/python scripts/kabul_olcumu.py
#
# Boylece yikim kalici bir yapilandirma degil, bilincli bir eylem olur.
