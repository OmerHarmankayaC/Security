# Bu dosyayi .env olarak kopyalayip degerleri kendi ortaminiza gore doldurun.
# .env asla commit edilmez (bkz. .gitignore).

VERITABANI_URL=postgresql+psycopg://vardiya:vardiya@localhost:5432/vardiya
COZUCU_ZAMAN_LIMITI_SANIYE=60
COZUCU_ARAMA_ISCISI_SAYISI=3
# Calisan panelinin kisiye ozel baglanti anahtarlarini ureten SUNUCU SIRRI
# (Backlog B-05). Her personelin anahtari bu sirdan HMAC ile turetilir
# (bkz. backend/app/services/calisan_baglantisi.py), bu yuzden:
#   - Dagitimda MUTLAKA rastgele uzun bir degerle degistirin; varsayilan
#     kalirsa anahtarlar tahmin edilebilir olur ve herkes herkesin
#     cizelgesini gorebilir.
#   - Degistirilmesi, daha once dagitilmis butun baglantilari gecersiz kilar
#     (yeni baglantilar scripts/calisan_baglantisi_uret.py ile uretilir).
CALISAN_PANELI_BAGLANTI_ANAHTARI=degistirilmeli
